---
import LanguagePicker from '../components/LanguagePicker.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { featuredProjectsES } from '../data/projects';
---
<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Carlos | Desarrollador Web & Móvil — SaaS, E-Commerce y Backend</title>
	<meta name="description" content="Portafolio de Carlos: desarrollo de aplicaciones web y móviles, plataformas SaaS, storefronts de e-commerce y sistemas backend con arquitecturas modernas.">

	<!-- Canonical & Alternates -->
	<link rel="canonical" href="https://webcarlos.dev/" />
	<link rel="alternate" hreflang="es" href="https://webcarlos.dev/" />
	<link rel="alternate" hreflang="en" href="https://webcarlos.dev/en/" />
	<link rel="alternate" hreflang="x-default" href="https://webcarlos.dev/" />

	<!-- Open Graph & Twitter -->
	<meta property="og:type" content="website" />
	<meta property="og:url" content="https://webcarlos.dev/" />
	<meta property="og:title" content="Carlos | Desarrollador Web & Móvil — SaaS, E-Commerce y Backend" />
	<meta property="og:description" content="Portafolio de Carlos: desarrollo de aplicaciones web y móviles, plataformas SaaS, storefronts de e-commerce y sistemas backend con arquitecturas modernas." />
	<meta property="og:image" content="https://webcarlos.dev/images/og-preview.png" />
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content="Carlos | Desarrollador Web & Móvil — SaaS, E-Commerce y Backend" />
	<meta name="twitter:description" content="Portafolio de Carlos: desarrollo de aplicaciones web y móviles, plataformas SaaS, storefronts de e-commerce y sistemas backend con arquitecturas modernas." />
	<meta name="twitter:image" content="https://webcarlos.dev/images/og-preview.png" />

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
	<style>
		:root {
			--bg-color: #FAFAFA;
			--bg-card: #FFFFFF;
			--text-main: #111111;
			--text-muted: #666666;
			--accent-primary: #3B82F6;
			--accent-hover: #2563EB;
			--border-color: #E5E5E5;
			--card-hover-border: #D4D4D4;
		}
		[data-theme="dark"] {
			--bg-color: #0A0A0A;
			--bg-card: #141414;
			--text-main: #EDEDED;
			--text-muted: #888888;
			--accent-primary: #3B82F6;
			--accent-hover: #60A5FA;
			--border-color: #222222;
			--card-hover-border: #333333;
		}
		* {
			box-sizing: border-box;
		}
		body {
			font-family: 'Inter', system-ui, sans-serif;
			background-color: var(--bg-color);
			color: var(--text-main);
			margin: 0;
			padding: 0;
			line-height: 1.6;
			transition: background-color 0.3s ease, color 0.3s ease;
			overflow-x: hidden;
		}
		.container {
			max-width: 1060px;
			margin: 0 auto;
			padding: 0 1.5rem;
		}

		h1, h2, h3, h4 {
			font-family: 'Space Grotesk', system-ui, sans-serif;
			letter-spacing: -0.02em;
		}

		/* Animaciones Globales */
		@keyframes slideUpFade {
			from { opacity: 0; transform: translateY(20px); }
			to { opacity: 1; transform: translateY(0); }
		}
		.hero-anim {
			opacity: 0;
			animation: slideUpFade 0.8s ease-out forwards;
		}
		.delay-1 { animation-delay: 0.1s; }
		.delay-2 { animation-delay: 0.2s; }
		.delay-3 { animation-delay: 0.3s; }
		.delay-4 { animation-delay: 0.4s; }

		.animate-on-scroll {
			opacity: 0;
			transform: translateY(24px);
			transition: opacity 0.7s ease-out, transform 0.7s ease-out;
		}
		.animate-on-scroll.show {
			opacity: 1;
			transform: translateY(0);
		}
		
		/* Navbar */
		nav {
			display: flex;
			justify-content: flex-end;
			padding: 1.5rem 0;
			gap: 1.5rem;
		}
		nav a {
			color: var(--text-muted);
			text-decoration: none;
			font-weight: 600;
			font-size: 0.95rem;
			transition: color 0.2s ease;
		}
		nav a:hover {
			color: var(--accent-primary);
		}

		/* Secciones */
		section {
			padding: 4.5rem 0;
			border-bottom: 1px solid var(--border-color);
		}
		section:last-of-type {
			border-bottom: none;
		}
		h2 {
			font-size: 2.2rem;
			margin-bottom: 2.2rem;
			color: var(--text-main);
			text-align: center;
		}

		/* Hero */
		.hero {
			padding: 5rem 0 3.5rem 0;
			text-align: center;
			display: flex;
			flex-direction: column;
			align-items: center;
		}
		.hero h1 {
			font-size: 3.8rem;
			font-weight: 700;
			margin: 0 0 0.5rem 0;
			color: var(--text-main);
			line-height: 1.15;
		}
		.hero h3 {
			font-size: 1.4rem;
			font-weight: 500;
			color: var(--text-muted);
			margin-top: 0;
			margin-bottom: 1.5rem;
		}
		.hero p {
			font-size: 1.2rem;
			max-width: 760px;
			margin-bottom: 2rem;
			color: var(--text-muted);
			line-height: 1.6;
		}
		.location {
			font-size: 1rem;
			color: var(--accent-primary);
			font-weight: 600;
		}
		.status-badge {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			background: var(--bg-card);
			border: 1px solid var(--border-color);
			padding: 0.35rem 0.9rem;
			border-radius: 9999px;
			font-size: 0.85rem;
			font-weight: 600;
			color: var(--text-main);
			margin-bottom: 1rem;
		}
		.status-dot {
			width: 8px;
			height: 8px;
			background-color: #22c55e;
			border-radius: 50%;
			box-shadow: 0 0 8px #22c55e;
		}
		.niche-badge {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			background: rgba(59, 130, 246, 0.08);
			color: var(--accent-primary);
			padding: 0.35rem 0.9rem;
			border-radius: 9999px;
			font-size: 0.8rem;
			font-weight: 700;
			margin-bottom: 1.25rem;
			border: 1px solid rgba(59, 130, 246, 0.25);
			letter-spacing: 0.04em;
			text-transform: uppercase;
		}
		.hero-buttons {
			display: flex;
			gap: 1rem;
			flex-wrap: wrap;
			justify-content: center;
		}
		.btn {
			padding: 0.8rem 1.6rem;
			border-radius: 10px;
			text-decoration: none;
			font-weight: 600;
			font-size: 0.95rem;
			transition: all 0.2s ease;
			display: inline-flex;
			align-items: center;
			justify-content: center;
		}
		.btn-primary {
			background: var(--accent-primary);
			color: #ffffff;
			border: 1px solid var(--accent-primary);
		}
		.btn-primary:hover {
			background: var(--accent-hover);
			border-color: var(--accent-hover);
			transform: translateY(-2px);
		}
		.btn-secondary {
			background: var(--bg-card);
			color: var(--text-main);
			border: 1px solid var(--border-color);
		}
		.btn-secondary:hover {
			border-color: var(--accent-primary);
			color: var(--accent-primary);
			transform: translateY(-2px);
		}

		/* Stats Bar */
		.stats-bar {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
			gap: 1rem;
			background: var(--bg-card);
			border: 1px solid var(--border-color);
			border-radius: 14px;
			padding: 1.25rem 1.5rem;
			margin: 1.5rem 0 3rem 0;
			text-align: center;
		}
		.stat-item {
			font-size: 0.88rem;
			font-weight: 600;
			color: var(--text-muted);
			padding: 0.4rem;
		}

		/* Qué resuelvo / Servicios */
		.services-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 2rem;
		}
		.service-card {
			background: var(--bg-card);
			border: 1px solid var(--border-color);
			border-radius: 16px;
			padding: 2rem;
			transition: transform 0.3s ease, border-color 0.3s ease;
		}
		.service-card:hover {
			transform: translateY(-3px);
			border-color: var(--card-hover-border);
		}
		.service-card h3 {
			font-size: 1.25rem;
			margin-top: 0;
			margin-bottom: 0.75rem;
			color: var(--text-main);
		}
		.service-card p {
			color: var(--text-muted);
			font-size: 0.95rem;
			line-height: 1.6;
			margin: 0;
		}

		/* Sobre Mí */
		.about-intro {
			max-width: 800px;
			margin: 0 auto 2.5rem auto;
			text-align: center;
			font-size: 1.1rem;
			color: var(--text-muted);
			line-height: 1.7;
		}
		.about-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
			gap: 1.5rem;
			margin-bottom: 2rem;
		}
		.about-card {
			background: var(--bg-card);
			border: 1px solid var(--border-color);
			border-radius: 14px;
			padding: 1.75rem;
		}
		.about-card h3 {
			margin-top: 0;
			margin-bottom: 0.5rem;
			font-size: 1.15rem;
			color: var(--text-main);
		}
		.about-card p {
			margin: 0;
			color: var(--text-muted);
			font-size: 0.92rem;
			line-height: 1.6;
		}
		.about-highlights {
			display: flex;
			flex-wrap: wrap;
			gap: 1rem;
			justify-content: center;
		}
		.highlight-item {
			background: var(--bg-card);
			border: 1px solid var(--border-color);
			padding: 0.5rem 1rem;
			border-radius: 8px;
			font-size: 0.85rem;
			color: var(--text-muted);
			font-weight: 500;
		}

		/* Stack */
		.stack-container {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
			gap: 2rem;
		}
		.stack-category {
			background: var(--bg-card);
			border: 1px solid var(--border-color);
			border-radius: 16px;
			padding: 1.75rem;
		}
		.stack-category h3 {
			margin-top: 0;
			margin-bottom: 1.25rem;
			font-size: 1.15rem;
			color: var(--text-main);
		}
		.stack-grid {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
		}
		.badge {
			background: var(--bg-color);
			border: 1px solid var(--border-color);
			padding: 0.4rem 0.8rem;
			border-radius: 8px;
			font-size: 0.85rem;
			font-weight: 600;
			color: var(--text-muted);
			transition: all 0.2s ease;
		}
		.badge:hover {
			border-color: var(--accent-primary);
			color: var(--accent-primary);
			transform: translateY(-1px);
		}

		/* Proyectos Grid & Cards Minimalistas */
		.projects-grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 2rem;
		}
		.projects-grid .project-card:first-child {
			grid-column: 1 / -1;
		}
		@media (max-width: 768px) {
			.projects-grid {
				grid-template-columns: 1fr;
				gap: 1.5rem;
			}
		}
		.project-card {
			background: var(--bg-card);
			border: 1px solid var(--border-color);
			border-radius: 20px;
			padding: 1.25rem;
			display: flex;
			flex-direction: column;
			transition: border-color 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
			position: relative;
		}
		.project-card.is-featured {
			border-color: rgba(59, 130, 246, 0.35);
			box-shadow: 0 4px 20px rgba(59, 130, 246, 0.04);
		}
		.project-card:hover {
			transform: translateY(-4px);
			border-color: var(--accent-primary);
			box-shadow: 0 16px 36px rgba(0, 0, 0, 0.08);
		}
		[data-theme="dark"] .project-card:hover {
			box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
		}
		.project-image-link {
			text-decoration: none;
			display: block;
		}
		.project-image-box {
			width: 100%;
			aspect-ratio: 16 / 9;
			border-radius: 16px;
			overflow: hidden;
			background: var(--bg-color);
			border: 1px solid var(--border-color);
			position: relative;
		}
		.project-image {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
			transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		}
		.project-card-leadops .project-image {
			object-fit: contain;
			background: var(--bg-card);
		}
		.project-card-leadops:hover .project-image {
			transform: none;
		}
		.project-card:hover .project-image {
			transform: scale(1.04);
		}
		.project-info {
			padding: 1.2rem 0.25rem 0.25rem 0.25rem;
			display: flex;
			flex-direction: column;
			flex-grow: 1;
		}
		.project-badges {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4rem;
			margin-bottom: 0.65rem;
		}
		.badge-tag {
			font-size: 0.7rem;
			font-weight: 700;
			padding: 0.2rem 0.55rem;
			border-radius: 6px;
			letter-spacing: 0.03em;
			text-transform: uppercase;
		}
		.badge-featured {
			background: rgba(59, 130, 246, 0.12);
			color: var(--accent-primary);
			border: 1px solid rgba(59, 130, 246, 0.3);
		}
		.badge-personal {
			background: rgba(168, 85, 247, 0.1);
			color: #C084FC;
			border: 1px solid rgba(168, 85, 247, 0.25);
		}
		[data-theme="light"] .badge-personal {
			color: #7E22CE;
			background: rgba(126, 34, 206, 0.08);
			border-color: rgba(126, 34, 206, 0.2);
		}
		.badge-cat {
			background: var(--bg-color);
			color: var(--text-muted);
			border: 1px solid var(--border-color);
		}
		.project-title-row {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.75rem;
			margin-bottom: 0.45rem;
		}
		.project-title {
			font-family: 'Space Grotesk', system-ui, sans-serif;
			font-size: 1.25rem;
			font-weight: 700;
			color: var(--text-main);
			margin: 0;
			line-height: 1.3;
			letter-spacing: -0.015em;
		}
		.project-title-link {
			color: inherit;
			text-decoration: none;
			transition: color 0.2s ease;
		}
		.project-title-link:hover {
			color: var(--accent-primary);
		}
		.project-arrow-link {
			text-decoration: none;
			color: inherit;
		}
		.project-arrow {
			font-size: 1.3rem;
			color: var(--text-muted);
			line-height: 1;
			transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
			display: inline-block;
		}
		.project-card:hover .project-arrow {
			transform: translateX(4px);
			color: var(--accent-primary);
		}
		.project-desc {
			font-size: 0.92rem;
			color: var(--text-muted);
			margin: 0 0 0.5rem 0;
			line-height: 1.5;
		}
		.project-stack {
			font-size: 0.8rem;
			color: var(--text-muted);
			opacity: 0.85;
			margin: 0.2rem 0 1rem 0;
			line-height: 1.45;
			font-weight: 400;
			word-break: normal;
			white-space: normal;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
		@media (max-width: 640px) {
			.project-stack {
				-webkit-line-clamp: 3;
			}
		}

		/* Acordeón Ver caso */
		.project-case-accordion {
			margin: 0.25rem 0 1.25rem 0;
			border: 1px solid var(--border-color);
			border-radius: 12px;
			background: var(--bg-color);
			transition: border-color 0.2s ease;
			overflow: hidden;
		}
		.project-case-accordion[open] {
			border-color: var(--card-hover-border, #333333);
		}
		.accordion-summary {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0.65rem 0.9rem;
			cursor: pointer;
			list-style: none;
			font-size: 0.85rem;
			font-weight: 600;
			color: var(--text-main);
			user-select: none;
			transition: color 0.2s ease;
		}
		.accordion-summary::-webkit-details-marker {
			display: none;
		}
		.accordion-summary:hover {
			color: var(--accent-primary);
		}
		.accordion-summary-icon {
			font-size: 0.9rem;
			transition: transform 0.25s ease;
			color: var(--text-muted);
		}
		.project-case-accordion[open] .accordion-summary-icon {
			transform: rotate(180deg);
			color: var(--accent-primary);
		}
		.accordion-body {
			padding: 0.75rem 0.9rem 1rem 0.9rem;
			border-top: 1px solid var(--border-color);
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			font-size: 0.84rem;
			line-height: 1.55;
		}
		.case-heading {
			font-size: 0.72rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			color: var(--accent-primary);
			margin: 0 0 0.25rem 0;
		}
		.case-text {
			margin: 0;
			color: var(--text-muted);
		}
		.case-stack-text {
			font-size: 0.82rem;
		}
		.case-sandbox {
			margin-top: 0.25rem;
			padding: 0.65rem 0.75rem;
			border-radius: 8px;
			background: rgba(59, 130, 246, 0.06);
			border: 1px solid rgba(59, 130, 246, 0.15);
		}
		.case-sandbox-title {
			margin: 0 0 0.2rem 0;
			font-size: 0.72rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			color: var(--text-main);
		}
		.case-sandbox-text {
			margin: 0;
			font-size: 0.78rem;
			color: var(--text-muted);
			line-height: 1.5;
		}

		/* Botones de acción unificados */
		.project-actions {
			display: flex;
			gap: 0.75rem;
			margin-top: auto;
			padding-top: 0.5rem;
		}
		.btn-action {
			flex: 1;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			padding: 0.55rem 1rem;
			font-size: 0.85rem;
			font-weight: 600;
			border-radius: 8px;
			text-decoration: none;
			transition: all 0.2s ease;
			text-align: center;
		}
		.btn-demo {
			background: var(--accent-primary);
			color: #FFFFFF;
			border: 1px solid var(--accent-primary);
		}
		.btn-demo:hover {
			background: var(--accent-hover);
			border-color: var(--accent-hover);
			transform: translateY(-1px);
		}
		.btn-repo {
			background: var(--bg-card);
			color: var(--text-main);
			border: 1px solid var(--border-color);
		}
		.btn-repo:hover {
			border-color: var(--accent-primary);
			color: var(--accent-primary);
			transform: translateY(-1px);
		}
		.more-projects-wrapper {
			display: flex;
			justify-content: center;
			margin-top: 3rem;
		}
		.btn-more-projects {
			padding: 0.85rem 2.2rem;
			font-size: 1rem;
			font-weight: 600;
			border-radius: 12px;
			transition: all 0.25s ease;
		}
		.btn-more-projects:hover {
			border-color: var(--accent-primary);
			color: var(--accent-primary);
			transform: translateY(-2px);
		}

		/* Por qué trabajar conmigo */
		.why-hire-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
			gap: 1.5rem;
			margin-top: 2rem;
		}
		.why-card {
			background: var(--bg-card);
			border: 1px solid var(--border-color);
