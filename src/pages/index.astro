	<script>
		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					entry.target.classList.add('show');
				}
			});
		}, { threshold: 0.1 });

		document.querySelectorAll('.animate-on-scroll').forEach((el) => {
			observer.observe(el);
		});

						document.querySelectorAll('[data-card-carousel]').forEach((carousel) => {
							const images = JSON.parse(carousel.dataset.cardImages || '[]');
							if (images.length < 2) return;

							const image = carousel.querySelector('[data-card-image]');
							let current = 0;
							let timer;

							const showNextImage = () => {
								current = (current + 1) % images.length;
								image.src = images[current];
								image.alt = `${carousel.dataset.cardTitle} — image ${current + 1}`;
							};

							const start = () => {
								window.clearInterval(timer);
								timer = window.setInterval(showNextImage, 4500);
							};

							carousel.addEventListener('mouseenter', () => window.clearInterval(timer));
							carousel.addEventListener('mouseleave', start);
							start();
						});
	</script>
