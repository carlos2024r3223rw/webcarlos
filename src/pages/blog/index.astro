---
import LanguagePicker from '../../components/LanguagePicker.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
---
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Blog | Carlos</title>
  <style>
    :root {
      --page-bg: #f8fafc;
      --page-text: #0f172a;
      --page-heading: #2563eb;
      --page-link: #3b82f6;
      --card-bg: #ffffff;
      --card-border: #e2e8f0;
    }
    [data-theme="dark"] {
      --page-bg: #0f172a;
      --page-text: #f8fafc;
      --page-heading: #38bdf8;
      --page-link: #818cf8;
      --card-bg: #1e293b;
      --card-border: #334155;
    }
    body {
      margin: 0;
      min-height: 100vh;
      background: var(--page-bg);
      color: var(--page-text);
      font-family: system-ui, -apple-system, sans-serif;
      padding: 2rem;
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
      transition: background-color 0.3s ease, color 0.3s ease;
    }
    h1 { color: var(--page-heading); }
    a { color: var(--page-link); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .post-list { margin-top: 2rem; }
    .post-card {
        background: var(--card-bg);
        padding: 1.5rem;
        border-radius: 8px;
        margin-bottom: 1rem;
        border: 1px solid var(--card-border);
        transition: background-color 0.3s ease, border-color 0.3s ease;
    }
  </style>
</head>
<body>
  <ThemeToggle />
  <LanguagePicker />
  <a href="/">← Volver al inicio</a>
  <h1>Blog</h1>
  <p>Mis últimos artículos sobre desarrollo web y tecnología.</p>
  
  <div class="post-list">
      <div class="post-card">
          <h2><a href="/blog/post-1">Primer Post de Ejemplo</a></h2>
          <p>Un breve ejemplo de cómo Astro maneja Markdown de forma nativa.</p>
      </div>
  </div>
</body>
</html>
