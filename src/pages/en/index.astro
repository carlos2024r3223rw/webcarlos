---
import LanguagePicker from '../../components/LanguagePicker.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
---
<html lang="en">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="viewport" content="width=device-width" />
	<title>Carlos | SaaS & eCommerce Full Stack Specialist</title>
	<meta name="description" content="Full Stack development consultant specialized in SaaS platforms and eCommerce. I optimize web applications to reduce user drop-off and increase business conversions. Available for freelance projects.">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
	<style>
		:root {
			--bg-color: #f8fafc;
			--bg-card: #ffffff;
			--text-main: #0f172a;
			--text-muted: #475569;
			--accent-primary: #2563eb;
			--accent-secondary: #1d4ed8;
			--border-color: #e2e8f0;
			--browser-header-bg: #f1f5f9;
			--credentials-bg: #f8fafc;
			--credentials-border: #e2e8f0;
			--credentials-text: #475569;
			--credentials-title: #1e293b;
		}
		[data-theme="dark"] {
			--bg-color: #0f172a;
			--bg-card: #1e293b;
			--text-main: #f1f5f9;
			--text-muted: #94a3b8;
			--accent-primary: #3b82f6;
			--accent-secondary: #2563eb;
			--border-color: #334155;
			--browser-header-bg: #1e293b;
			--credentials-bg: #0f172a;
			--credentials-border: #334155;
			--credentials-text: #94a3b8;
			--credentials-title: #f1f5f9;
		}
		* {
			box-sizing: border-box;
		}
		body {
			font-family: 'Inter', system-ui, sans-serif;
			background-color: var(--bg-color);
			color: var(--text-main);
			margin: 0;
			padding: 0;
			line-height: 1.6;
			transition: background-color 0.3s ease, color 0.3s ease;
		}
		.container {
			max-width: 1000px;
			margin: 0 auto;
			padding: 0 2rem;
		}

		/* Animaciones Globales */
		@keyframes slideUpFade {
			from { opacity: 0; transform: translateY(20px); }
			to { opacity: 1; transform: translateY(0); }
		}
		.hero-anim {
			opacity: 0;
			animation: slideUpFade 0.8s ease-out forwards;
		}
		.delay-1 { animation-delay: 0.1s; }
		.delay-2 { animation-delay: 0.2s; }
		.delay-3 { animation-delay: 0.3s; }
		.delay-4 { animation-delay: 0.4s; }

		.animate-on-scroll {
			opacity: 0;
			transform: translateY(30px);
			transition: opacity 0.8s ease-out, transform 0.8s ease-out;
		}
		.animate-on-scroll.show {
			opacity: 1;
			transform: translateY(0);
		}
		
		/* Navbar */
		nav {
			display: flex;
			justify-content: flex-end;
			padding: 1.5rem 0;
			gap: 1.5rem;
		}
		nav a {
			color: var(--text-muted);
			text-decoration: none;
			font-weight: 600;
			transition: color 0.3s;
		}
		nav a:hover {
			color: var(--accent-primary);
		}

		/* Secciones genéricas */
		section {
			padding: 4rem 0;
			border-bottom: 1px solid var(--border-color);
		}
		section:last-of-type {
			border-bottom: none;
		}
		h2 {
			font-size: 2rem;
			margin-bottom: 2rem;
			color: var(--text-main);
			text-align: center;
		}

		/* Hero */
		.hero {
			padding: 5rem 0 3rem 0;
			text-align: center;
			display: flex;
			flex-direction: column;
			align-items: center;
		}
		.hero h1 {
			font-size: 4rem;
			font-weight: 800;
			margin: 0 0 0.5rem 0;
			color: var(--text-main);
			line-height: 1.2;
		}
		.hero h3 {
			font-size: 1.5rem;
			font-weight: 400;
			color: var(--text-muted);
			margin-top: 0;
			margin-bottom: 1.5rem;
		}
		.hero p {
			font-size: 1.1rem;
			max-width: 700px;
			color: var(--text-muted);
			margin-bottom: 2.5rem;
		}
		.hero-buttons {
			display: flex;
			justify-content: center;
			gap: 1rem;
		}
		.btn {
			display: inline-block;
			padding: 0.75rem 1.5rem;
			border-radius: 8px;
			text-decoration: none;
			font-weight: 600;
			transition: all 0.3s ease;
		}
		.btn-primary {
			background: var(--accent-primary);
			color: #ffffff;
		}
		.btn-primary:hover {
			background: var(--accent-secondary);
			transform: translateY(-2px);
			box-shadow: 0 10px 20px rgba(37, 99, 235, 0.2);
		}
		.btn-secondary {
			background: transparent;
			color: var(--text-main);
			border: 1px solid var(--border-color);
		}
		.btn-secondary:hover {
			border-color: var(--accent-primary);
			color: var(--accent-primary);
			transform: translateY(-2px);
		}

		/* Hero Extras */
		.status-badge {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			background: rgba(16, 185, 129, 0.1);
			color: #10b981;
			padding: 0.4rem 0.8rem;
			border-radius: 9999px;
			font-size: 0.85rem;
			font-weight: 600;
			margin-bottom: 1.5rem;
			border: 1px solid rgba(16, 185, 129, 0.2);
		}
		.status-dot {
			width: 8px;
			height: 8px;
			background-color: #10b981;
			border-radius: 50%;
			box-shadow: 0 0 8px #10b981;
			animation: pulse 2s infinite;
		}
		@keyframes pulse {
			0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
			70% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
			100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
		}
		.location {
			font-size: 1.1rem;
			color: var(--text-muted);
			font-weight: 400;
			margin-left: 0.5rem;
		}

		/* Stats Bar */
		.stats-bar {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 2rem;
			padding: 2rem 0;
			margin-bottom: 2rem;
			border-top: 1px solid var(--border-color);
			border-bottom: 1px solid var(--border-color);
		}
		.stat-item {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			color: var(--text-main);
			font-weight: 600;
			font-size: 0.95rem;
		}

		/* Sobre Mí */
		.about {
			max-width: 1000px;
			margin: 0 auto;
		}
		.about-intro {
			font-size: 1.15rem;
			color: var(--text-muted);
			max-width: 800px;
			margin: 0 auto 3rem auto;
			text-align: center;
			line-height: 1.8;
		}
		.about-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 2rem;
			margin-bottom: 3rem;
		}
		.about-card {
			background: var(--bg-card);
			border: 1px solid var(--border-color);
			border-radius: 12px;
			padding: 2rem;
			box-shadow: 0 4px 6px rgba(0,0,0,0.02);
		}
		.about-card h3 {
			margin-top: 0;
			color: var(--text-main);
			font-size: 1.15rem;
			margin-bottom: 1rem;
		}
		.about-card p {
			color: var(--text-muted);
			font-size: 0.95rem;
			margin-bottom: 0;
		}
		.about-highlights {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 2rem;
			background: var(--bg-card);
			border: 1px solid var(--border-color);
			padding: 2rem;
			border-radius: 12px;
		}
		.highlight-item {
			display: flex;
			align-items: center;
			gap: 0.6rem;
			color: var(--text-muted);
			font-size: 0.95rem;
			font-weight: 500;
		}

		/* Servicios */
		.services-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 2rem;
		}
		.service-card {
			background: var(--bg-card);
			border: 1px solid var(--border-color);
			border-radius: 12px;
			padding: 2rem;
			box-shadow: 0 4px 6px rgba(0,0,0,0.02);
			transition: transform 0.3s ease;
		}
		.service-card:hover {
			transform: translateY(-3px);
			box-shadow: 0 8px 15px rgba(0,0,0,0.05);
		}
		.service-card h3 {
			margin-top: 0;
			color: var(--text-main);
			font-size: 1.2rem;
			margin-bottom: 0.5rem;
		}
		.service-card p {
			color: var(--text-muted);
			font-size: 0.95rem;
			margin-bottom: 0;
		}

		/* Stack Categories */
		.stack-section {
			text-align: left;
		}
		.stack-container {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
			gap: 2rem;
		}
		.stack-category {
			background: var(--bg-card);
			border: 1px solid var(--border-color);
			padding: 1.5rem;
			border-radius: 12px;
			box-shadow: 0 4px 6px rgba(0,0,0,0.02);
		}
		.stack-category h3 {
			font-size: 1.1rem;
			color: var(--text-main);
			margin-top: 0;
			margin-bottom: 1rem;
			font-weight: 600;
			border-bottom: 1px solid var(--border-color);
			padding-bottom: 0.5rem;
		}
		.stack-grid {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
		}
		.badge {
			background: var(--bg-color);
			border: 1px solid var(--border-color);
			padding: 0.4rem 0.8rem;
			border-radius: 6px;
			font-size: 0.85rem;
			font-weight: 600;
			color: var(--text-muted);
			transition: all 0.3s ease;
			display: flex;
			align-items: center;
			gap: 0.4rem;
			cursor: default;
		}
		.badge:hover {
			border-color: var(--accent-primary);
			color: var(--accent-primary);
			background: var(--bg-card);
			transform: translateY(-2px);
			box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
		}

		/* Projects */
		.projects-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
			gap: 2.5rem;
		}
		@media (max-width: 800px) {
			.projects-grid {
				grid-template-columns: 1fr;
			}
		}
		.project-card {
			background: var(--bg-card);
			border: 1px solid var(--border-color);
			border-radius: 12px;
			transition: all 0.3s ease;
			display: flex;
			flex-direction: column;
			position: relative;
			overflow: hidden;
			box-shadow: 0 4px 6px rgba(0, 0, 0, 0.03);
		}
		.project-card:hover {
			transform: translateY(-5px);
			border-color: var(--accent-primary);
			box-shadow: 0 12px 25px rgba(0, 0, 0, 0.08);
		}
		.browser-header {
			background: var(--browser-header-bg);
			padding: 0.75rem 1rem;
			display: flex;
			gap: 0.4rem;
			border-bottom: 1px solid var(--border-color);
			transition: background-color 0.3s ease;
		}
		.dot {
			width: 10px;
			height: 10px;
			border-radius: 50%;
		}
		.dot-red { background: #ef4444; }
		.dot-yellow { background: #f59e0b; }
		.dot-green { background: #10b981; }
		
		.project-content {
			padding: 1.5rem;
			flex-grow: 1;
			display: flex;
			flex-direction: column;
		}
		.project-content h3 {
			margin-top: 0;
			color: var(--text-main);
			font-size: 1.3rem;
			margin-bottom: 0.5rem;
		}
		.project-content p {
			color: var(--text-muted);
			font-size: 0.95rem;
			margin-bottom: 0;
		}
		.project-tags {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4rem;
			margin-bottom: 1.5rem;
		}
		.tag {
			font-size: 0.75rem;
			padding: 0.2rem 0.6rem;
			background: var(--bg-color);
			color: var(--text-muted);
			border-radius: 4px;
			border: 1px solid var(--border-color);
			font-weight: 600;
		}
		.project-links {
			display: flex;
			gap: 0.8rem;
			margin-top: auto;
			padding-top: 1.25rem;
		}
		.demo-credentials {
			margin-top: 1rem;
			padding: 0.75rem;
			border-radius: 0.5rem;
			background-color: var(--credentials-bg);
			border: 1px solid var(--credentials-border);
			font-size: 0.75rem;
			color: var(--credentials-text);
			font-family: monospace;
			transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
		}
		.demo-credentials p {
			margin: 0;
			line-height: 1.5;
		}
		.demo-credentials-title {
			font-weight: 600;
			color: var(--credentials-title);
			font-family: sans-serif;
			margin-bottom: 0.25rem !important;
		}
		.btn-small {
			padding: 0.5rem 1rem;
			font-size: 0.85rem;
			border-radius: 6px;
			text-decoration: none;
			font-weight: 600;
			transition: all 0.2s;
			text-align: center;
			flex: 1;
		}
		.btn-demo {
			background: var(--accent-primary);
			color: #ffffff;
		}
		.btn-demo:hover {
			background: var(--accent-secondary);
		}
		.btn-repo {
			background: transparent;
			color: var(--text-main);
			border: 1px solid var(--border-color);
		}
		.btn-repo:hover {
			border-color: var(--text-main);
		}

		/* ROI Metrics */
		.roi-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
			gap: 1.5rem;
			margin-top: 2.5rem;
		}
		.roi-card {
			background: var(--bg-card);
			border: 1px solid var(--border-color);
			border-radius: 12px;
			padding: 1.5rem;
			text-align: center;
			transition: all 0.3s ease;
		}
		.roi-card:hover {
			transform: translateY(-4px);
			border-color: var(--accent-primary);
			box-shadow: 0 8px 20px rgba(37,99,235,0.1);
		}
		.roi-number {
			font-size: 2.5rem;
			font-weight: 800;
			color: var(--accent-primary);
			line-height: 1;
			margin-bottom: 0.5rem;
		}
		.roi-label {
			font-size: 0.9rem;
			color: var(--text-muted);
			font-weight: 500;
		}

		/* Niche Badge */
		.niche-badge {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			background: rgba(37, 99, 235, 0.08);
			color: var(--accent-primary);
			padding: 0.4rem 1rem;
			border-radius: 9999px;
			font-size: 0.85rem;
			font-weight: 700;
			margin-bottom: 1rem;
			border: 1px solid rgba(37, 99, 235, 0.25);
			letter-spacing: 0.03em;
			text-transform: uppercase;
		}

		/* Case Study inside project card */
		.case-study {
			margin-top: 1.25rem;
			padding: 1.1rem 1.25rem;
			background: var(--bg-color);
			border: 1px solid var(--border-color);
			border-radius: 10px;
			font-size: 0.875rem;
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
		}
		.case-study-row {
			display: flex;
			flex-direction: column;
			gap: 0.2rem;
			line-height: 1.6;
		}
		.case-label {
			font-weight: 700;
			color: var(--accent-primary);
			font-size: 0.78rem;
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}
		.case-text {
			color: var(--text-muted);
			line-height: 1.55;
		}

		/* Testimonials */
		.testimonials-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 2rem;
		}
		.testimonial-card {
			background: var(--bg-card);
			border: 1px solid var(--border-color);
			border-radius: 12px;
			padding: 2rem;
			box-shadow: 0 4px 6px rgba(0,0,0,0.02);
			position: relative;
			transition: transform 0.3s ease;
		}
		.testimonial-card:hover {
			transform: translateY(-3px);
			box-shadow: 0 10px 25px rgba(0,0,0,0.07);
		}
		.quote-icon {
			font-size: 3rem;
			line-height: 1;
			color: var(--accent-primary);
			opacity: 0.2;
			position: absolute;
			top: 1rem;
			right: 1.5rem;
			font-family: Georgia, serif;
		}
		.testimonial-text {
			color: var(--text-muted);
			font-size: 0.95rem;
			line-height: 1.7;
			margin: 0 0 1.5rem 0;
			font-style: italic;
		}
		.testimonial-stars {
			color: #f59e0b;
			font-size: 0.9rem;
			margin-bottom: 1rem;
			letter-spacing: 2px;
		}
		.testimonial-author {
			display: flex;
			align-items: center;
			gap: 0.75rem;
		}
		.author-avatar {
			width: 42px;
			height: 42px;
			border-radius: 50%;
			background: linear-gradient(135deg, var(--accent-primary), #8b5cf6);
			display: flex;
			align-items: center;
			justify-content: center;
			color: white;
			font-weight: 700;
			font-size: 1rem;
			flex-shrink: 0;
		}
		.author-info strong {
			display: block;
			color: var(--text-main);
			font-size: 0.95rem;
		}
		.author-info span {
			color: var(--text-muted);
			font-size: 0.8rem;
		}

		/* Why Hire Me */
		.why-hire-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
			gap: 1.5rem;
			margin-top: 2rem;
		}
		.why-card {
			background: var(--bg-card);
			border: 1px solid var(--border-color);
			border-radius: 12px;
			padding: 1.5rem;
			text-align: center;
			transition: all 0.3s ease;
		}
		.why-card:hover {
			border-color: var(--accent-primary);
			transform: translateY(-3px);
		}
		.why-card h3 {
			margin: 0 0 0.5rem 0;
			font-size: 1rem;
			color: var(--text-main);
		}
		.why-card p {
			margin: 0;
			font-size: 0.875rem;
			color: var(--text-muted);
		}

		/* Contact */
		.contact-container {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 4rem;
			max-width: 900px;
			margin: 0 auto;
		}
		@media (max-width: 768px) {
			.contact-container {
				grid-template-columns: 1fr;
			}
		}
		.contact-form {
			background: var(--bg-card);
			padding: 2.5rem;
			border-radius: 12px;
			border: 1px solid var(--border-color);
			box-shadow: 0 4px 6px rgba(0,0,0,0.02);
		}
		.form-group {
			margin-bottom: 1.5rem;
		}
		.form-group label {
			display: block;
			margin-bottom: 0.5rem;
			color: var(--text-main);
			font-weight: 600;
			font-size: 0.9rem;
		}
		.form-control {
			width: 100%;
			padding: 0.75rem 1rem;
			border: 1px solid var(--border-color);
			border-radius: 8px;
			background: var(--bg-color);
			color: var(--text-main);
			font-family: inherit;
			font-size: 1rem;
			transition: border-color 0.3s;
		}
		.form-control:focus {
			outline: none;
			border-color: var(--accent-primary);
		}
		textarea.form-control {
			resize: vertical;
			min-height: 120px;
		}
		.btn-submit {
			width: 100%;
			border: none;
			cursor: pointer;
			text-align: center;
		}
		.contact-info {
			display: flex;
			flex-direction: column;
			justify-content: center;
		}
		.contact-info h3 {
			margin-top: 0;
			color: var(--text-main);
			font-size: 1.8rem;
			margin-bottom: 1rem;
		}
		.contact-info p {
			color: var(--text-muted);
			font-size: 1.1rem;
			margin-bottom: 2rem;
		}
		.direct-email {
