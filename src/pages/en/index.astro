			margin-bottom: 0.5rem;
			color: var(--text-main);
			font-weight: 600;
			font-size: 0.9rem;
		}
		.form-control {
			width: 100%;
			padding: 0.75rem 1rem;
			border: 1px solid var(--border-color);
			border-radius: 8px;
			background: var(--bg-color);
			color: var(--text-main);
