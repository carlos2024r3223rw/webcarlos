			color: var(--text-main);
		}
		.contact-info p {
			color: var(--text-muted);
			margin-bottom: 1.5rem;
			line-height: 1.6;
		}
		.direct-email {
			font-size: 1.2rem;
			color: var(--accent-primary);
			text-decoration: none;
			font-weight: 600;
			margin-bottom: 2rem;
