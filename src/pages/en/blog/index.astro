---
import LanguagePicker from '../../components/LanguagePicker.astro';
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Blog | Carlos</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      background: #0f172a;
      color: #f8fafc;
      font-family: system-ui, -apple-system, sans-serif;
      padding: 2rem;
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
    }
    h1 { color: #38bdf8; }
    a { color: #818cf8; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .post-list { margin-top: 2rem; }
    .post-card {
        background: #1e293b;
        padding: 1.5rem;
        border-radius: 8px;
        margin-bottom: 1rem;
        border: 1px solid #334155;
    }
  </style>
</head>
<body>
  <LanguagePicker />
  <a href="/en/">← Back to Home</a>
  <h1>Blog</h1>
  <p>My latest articles on web development and technology.</p>
  
  <div class="post-list">
      <div class="post-card">
          <h2><a href="/en/blog/post-1">First Example Post</a></h2>
          <p>A brief example of how Astro handles Markdown natively.</p>
      </div>
  </div>
</body>
</html>
