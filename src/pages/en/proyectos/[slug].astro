---
import LanguagePicker from '../../../components/LanguagePicker.astro';
import ThemeToggle from '../../../components/ThemeToggle.astro';
import { projectsEN, type Project } from '../../../data/projects';

export async function getStaticPaths() {
  return projectsEN.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{project.title} | Carlos — Project Portfolio</title>
  <meta name="description" content={`Technical deep-dive for ${project.title}: architecture, tech stack, problem addressed, and solution implemented.`} />

  <!-- Canonical & hreflang -->
  <link rel="canonical" href={`https://webcarlos.dev/en/proyectos/${project.slug}`} />
  <link rel="alternate" hreflang="es" href={`https://webcarlos.dev/proyectos/${project.slug}`} />
  <link rel="alternate" hreflang="en" href={`https://webcarlos.dev/en/proyectos/${project.slug}`} />
  <link rel="alternate" hreflang="x-default" href={`https://webcarlos.dev/proyectos/${project.slug}`} />

  <!-- Open Graph & Twitter -->
  <meta property="og:type" content="article" />
  <meta property="og:url" content={`https://webcarlos.dev/en/proyectos/${project.slug}`} />
  <meta property="og:title" content={`${project.title} | Carlos`} />
  <meta property="og:description" content={project.shortDesc} />
  <meta property="og:image" content={`https://webcarlos.dev${project.image}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${project.title} | Carlos`} />
  <meta name="twitter:description" content={project.shortDesc} />
  <meta name="twitter:image" content={`https://webcarlos.dev${project.image}`} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-color: #FAFAFA;
      --bg-card: #FFFFFF;
      --text-main: #111111;
      --text-muted: #666666;
      --accent-primary: #3B82F6;
      --accent-hover: #2563EB;
      --border-color: #E5E5E5;
      --card-hover-border: #D4D4D4;
    }

    [data-theme="dark"] {
      --bg-color: #0A0A0A;
      --bg-card: #141414;
      --text-main: #EDEDED;
      --text-muted: #888888;
      --accent-primary: #3B82F6;
      --accent-hover: #60A5FA;
      --border-color: #222222;
      --card-hover-border: #333333;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: 'Inter', system-ui, sans-serif;
      line-height: 1.6;
      transition: background-color 0.3s ease, color 0.3s ease;
      min-height: 100vh;
    }

    h1, h2, h3, h4 {
      font-family: 'Space Grotesk', system-ui, sans-serif;
      letter-spacing: -0.02em;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
      padding: 2rem 1.5rem 5rem 1.5rem;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2.5rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border-color);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 500;
      transition: color 0.2s ease, transform 0.2s ease;
    }

    .back-link:hover {
      color: var(--accent-primary);
      transform: translateX(-3px);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .project-hero {
      margin-bottom: 2.5rem;
    }

    .project-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    .badge-tag {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.22rem 0.6rem;
      border-radius: 6px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .badge-featured {
      background: rgba(59, 130, 246, 0.12);
      color: var(--accent-primary);
      border: 1px solid rgba(59, 130, 246, 0.3);
    }

    .badge-personal {
      background: rgba(168, 85, 247, 0.1);
      color: #C084FC;
      border: 1px solid rgba(168, 85, 247, 0.25);
    }

    [data-theme="light"] .badge-personal {
      color: #7E22CE;
      background: rgba(126, 34, 206, 0.08);
      border-color: rgba(126, 34, 206, 0.2);
    }

    .badge-cat {
      background: var(--bg-card);
      color: var(--text-muted);
      border: 1px solid var(--border-color);
    }

    .project-title {
      font-size: 2.5rem;
      font-weight: 700;
      margin: 0 0 1rem 0;
      line-height: 1.2;
    }

    .project-desc {
      font-size: 1.15rem;
      color: var(--text-muted);
      margin: 0 0 1.5rem 0;
      line-height: 1.6;
      max-width: 780px;
    }

    .project-cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.75rem 1.4rem;
      border-radius: 10px;
      font-size: 0.92rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .btn-primary {
      background: var(--accent-primary);
      color: #ffffff;
      border: 1px solid var(--accent-primary);
    }

    .btn-primary:hover {
      background: var(--accent-hover);
      border-color: var(--accent-hover);
      transform: translateY(-2px);
    }

    .btn-secondary {
      background: var(--bg-card);
      color: var(--text-main);
      border: 1px solid var(--border-color);
    }

    .btn-secondary:hover {
      border-color: var(--accent-primary);
      color: var(--accent-primary);
      transform: translateY(-2px);
    }

    .preview-box {
      width: 100%;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid var(--border-color);
      background: var(--bg-card);
      margin-bottom: 3rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    }

    .preview-image {
      width: 100%;
      height: auto;
      display: block;
      aspect-ratio: 16 / 9;
      object-fit: cover;
    }

    .case-study-grid {
      display: grid;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .info-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 1.75rem;
      transition: border-color 0.2s ease;
    }

    .info-card:hover {
      border-color: var(--card-hover-border);
    }

    .info-label {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent-primary);
      margin-bottom: 0.5rem;
      display: block;
    }

    .info-text {
      margin: 0;
      font-size: 1rem;
      line-height: 1.7;
      color: var(--text-main);
    }

    .stack-text {
      color: var(--text-muted);
      font-size: 0.95rem;
      line-height: 1.6;
    }

    .extra-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 1.5rem 1.75rem;
      margin-top: 1.5rem;
    }

    .extra-title {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      margin: 0 0 0.5rem 0;
    }

    .extra-content {
      margin: 0;
      font-size: 0.9rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    @media (max-width: 640px) {
      .project-title {
        font-size: 1.9rem;
      }
      .project-desc {
        font-size: 1rem;
      }
      .container {
        padding: 1.5rem 1rem 3rem 1rem;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <a href="/en/#projects" class="back-link">
        <span>←</span> Back to projects
      </a>
      <div class="header-actions">
        <ThemeToggle />
        <LanguagePicker />
      </div>
    </header>

    <main>
      <div class="project-hero">
        <div class="project-badges">
          {project.isFeatured && (
            <span class="badge-tag badge-featured">Featured</span>
          )}
          {project.isPersonal && (
            <span class="badge-tag badge-personal">Personal project</span>
          )}
          <span class="badge-tag badge-cat">{project.category}</span>
        </div>

        <h1 class="project-title">{project.title}</h1>
        <p class="project-desc">{project.shortDesc}</p>

        <div class="project-cta-row">
          {project.demoUrl && (
            <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              Demo
            </a>
          )}
          {project.repoUrl && (
            <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              Repository
            </a>
          )}
        </div>
      </div>

      <div class="preview-box">
        <img src={project.image} alt={project.title} class="preview-image" />
      </div>

      <div class="case-study-grid">
        <div class="info-card">
          <span class="info-label">Problem addressed</span>
          <p class="info-text">{project.problem}</p>
        </div>

        <div class="info-card">
          <span class="info-label">Solution</span>
          <p class="info-text">{project.solution}</p>
        </div>

        <div class="info-card">
          <span class="info-label">Tech Stack</span>
          <p class="info-text stack-text">{project.stackDetail || project.stackText}</p>
        </div>
      </div>

      {project.sandboxInfo && (
        <div class="extra-card">
          <p class="extra-title">{project.sandboxInfo.title}</p>
          <p class="extra-content">{project.sandboxInfo.content}</p>
        </div>
      )}
    </main>
  </div>
</body>
</html>
