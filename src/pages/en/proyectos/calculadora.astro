---
import LanguagePicker from '../../../components/LanguagePicker.astro';
import ThemeToggle from '../../../components/ThemeToggle.astro';
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Calculator | Carlos</title>
  <style>
    :root {
      --calc-body-bg: #f8fafc;
      --calc-bg: #ffffff;
      --calc-border: #e2e8f0;
      --calc-shadow: rgba(0,0,0,0.15);
      --calc-heading: #2563eb;
      --calc-display-bg: #f1f5f9;
      --calc-display-border: #e2e8f0;
      --calc-display-text: #0f172a;
      --calc-btn-bg: #e2e8f0;
      --calc-btn-hover: #cbd5e1;
      --calc-btn-text: #0f172a;
      --calc-btn-accent: #3b82f6;
      --calc-btn-accent-hover: #2563eb;
      --calc-link: #3b82f6;
    }
    [data-theme="dark"] {
      --calc-body-bg: #0f172a;
      --calc-bg: #1e293b;
      --calc-border: #334155;
      --calc-shadow: rgba(0,0,0,0.5);
      --calc-heading: #38bdf8;
      --calc-display-bg: #0f172a;
      --calc-display-border: #334155;
      --calc-display-text: #f8fafc;
      --calc-btn-bg: #334155;
      --calc-btn-hover: #475569;
      --calc-btn-text: #ffffff;
      --calc-btn-accent: #3b82f6;
      --calc-btn-accent-hover: #2563eb;
      --calc-link: #818cf8;
    }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: var(--calc-body-bg);
      color: var(--calc-display-text);
      font-family: system-ui, -apple-system, sans-serif;
      transition: background-color 0.3s ease, color 0.3s ease;
    }
    .calculator {
      background: var(--calc-bg);
      padding: 1.5rem;
      border-radius: 12px;
      box-shadow: 0 10px 25px var(--calc-shadow);
      border: 1px solid var(--calc-border);
      width: 280px;
      transition: background-color 0.3s ease, border-color 0.3s ease;
    }
    h2 {
      margin: 0 0 1rem 0;
      font-size: 1.2rem;
      text-align: center;
      color: var(--calc-heading);
    }
    .display {
      background: var(--calc-display-bg);
      padding: 1rem;
      border-radius: 8px;
      font-size: 2rem;
      text-align: right;
      margin-bottom: 1rem;
      border: 1px solid var(--calc-display-border);
      overflow-x: auto;
      min-height: 40px;
      color: var(--calc-display-text);
      transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
    }
    .buttons {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.5rem;
    }
    button {
      background: var(--calc-btn-bg);
      color: var(--calc-btn-text);
      border: none;
      padding: 1rem;
      font-size: 1.2rem;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.2s;
    }
    button:hover {
      background: var(--calc-btn-hover);
    }
    .wide {
      grid-column: span 2;
    }
    .tall {
      grid-row: span 2;
      background: var(--calc-btn-accent);
      color: #ffffff;
    }
    .tall:hover {
      background: var(--calc-btn-accent-hover);
    }
    .back-link {
      position: absolute;
      top: 1rem;
      left: 1rem;
      color: var(--calc-link);
      text-decoration: none;
      font-family: sans-serif;
    }
  </style>
</head>
<body>
  <ThemeToggle />
  <LanguagePicker />
  <a href="/en/proyectos" class="back-link">← Back to Projects</a>
  
  <div class="calculator">
    <h2>Calculator</h2>
    <div class="display" id="display">0</div>
    <div class="buttons">
      <button class="calc-btn" data-action="clear">C</button>
      <button class="calc-btn" data-val="/">/</button>
      <button class="calc-btn" data-val="*">*</button>
      <button class="calc-btn" data-val="-">-</button>
      
      <button class="calc-btn" data-val="7">7</button>
      <button class="calc-btn" data-val="8">8</button>
      <button class="calc-btn" data-val="9">9</button>
      <button class="calc-btn tall" data-val="+">+</button>
      
      <button class="calc-btn" data-val="4">4</button>
      <button class="calc-btn" data-val="5">5</button>
      <button class="calc-btn" data-val="6">6</button>
      
      <button class="calc-btn" data-val="1">1</button>
      <button class="calc-btn" data-val="2">2</button>
      <button class="calc-btn" data-val="3">3</button>
      <button class="calc-btn tall" data-action="calc">=</button>
      
      <button class="calc-btn wide" data-val="0">0</button>
      <button class="calc-btn" data-val=".">.</button>
    </div>
  </div>

  <script>
    const display = document.getElementById('display');
    const buttons = document.querySelectorAll('.calc-btn');

    buttons.forEach(button => {
      button.addEventListener('click', () => {
        const val = button.getAttribute('data-val');
        const action = button.getAttribute('data-action');

        if (action === 'clear') {
          display.innerText = '0';
        } else if (action === 'calc') {
          try {
            // Evaluating string with caution, ideal for simple sandbox
            display.innerText = eval(display.innerText);
          } catch (e) {
            display.innerText = 'Error';
            setTimeout(() => display.innerText = '0', 1500);
          }
        } else if (val) {
          if (display.innerText === '0' && val !== '.') {
            display.innerText = val;
          } else {
            display.innerText += val;
          }
        }
      });
    });
  </script>
</body>
</html>
